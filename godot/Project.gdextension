[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.4
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://../rust/target/debug/librust.so"
linux.release.x86_64 =   "res://../rust/target/release/librust.so"
windows.debug.x86_64 =   "res://../rust/target/debug/rust.dll"
windows.release.x86_64 = "res://../rust/target/release/rust.dll"
macos.debug =            "res://../rust/target/debug/librust.dylib"
macos.release =          "res://../rust/target/release/librust.dylib"
macos.debug.arm64 =      "res://../rust/target/debug/librust.dylib"
macos.release.arm64 =    "res://../rust/target/release/librust.dylib"
web.debug.wasm32 =       "res://../rust/target/wasm32-unknown-emscripten/debug/rust.wasm"
web.release.wasm32 =     "res://../rust/target/wasm32-unknown-emscripten/release/rust.wasm"
android.debug.arm64 =    "res://../rust/target/aarch64-linux-android/debug/librust.so"
android.release.arm64 =    "res://../rust/target/aarch64-linux-android/release/librust.so"

[icons]
Car = "res://assets/RustNode.svg"
Collectibles = "res://assets/RustNode.svg"
ContentLoader = "res://assets/RustNode.svg"
GraveTexts = "res://assets/RustNode.svg"
FlipDetection = "res://assets/RustNode.svg"
Level = "res://assets/RustNode.svg"
PlayerCamera = "res://assets/RustNode.svg"
PlayerInput = "res://assets/RustNode.svg"
